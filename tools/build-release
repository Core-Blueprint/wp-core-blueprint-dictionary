#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLUGIN_SLUG="core-blueprint-dictionary"
MAIN_FILE="core-blueprint-dictionary.php"
ENTRY_FILE="$ROOT_DIR/$MAIN_FILE"
README_FILE="$ROOT_DIR/readme.txt"
BUILD_DIR="$ROOT_DIR/build"
STAGE_DIR="$BUILD_DIR/$PLUGIN_SLUG"

fail() {
  printf 'Dictionary release build failed: %s\n' "$*" >&2
  exit 1
}

header_value() {
  local file="$1" label="$2"
  php -r '
    $lines = @file($argv[1], FILE_IGNORE_NEW_LINES);
    if (!is_array($lines)) { exit(2); }
    $label = preg_quote($argv[2], "/");
    foreach ($lines as $line) {
      if (preg_match("/^\\s*\\*?\\s*{$label}:\\s*(.*?)\\s*$/", $line, $m)) {
        echo $m[1];
        exit(0);
      }
    }
  ' "$file" "$label"
}

define_value() {
  local file="$1" name="$2"
  php -r '
    $source = @file_get_contents($argv[1]);
    if (!is_string($source)) { exit(2); }
    $name = preg_quote($argv[2], "/");
    if (preg_match("/define\\(\\s*[\\x27\\x22]{$name}[\\x27\\x22]\\s*,\\s*[\\x27\\x22]([^\\x27\\x22]+)[\\x27\\x22]\\s*\\)/", $source, $m)) {
      echo $m[1];
    }
  ' "$file" "$name"
}

for command in php zip unzip sha256sum find sort touch grep; do
  command -v "$command" >/dev/null 2>&1 || fail "missing required command: $command"
done

[[ -f "$ENTRY_FILE" ]] || fail "plugin entrypoint is missing"
[[ -f "$README_FILE" ]] || fail "readme.txt is missing"

VERSION="$(header_value "$ENTRY_FILE" 'Version')"
CONSTANT_VERSION="$(define_value "$ENTRY_FILE" 'CB_DICTIONARY_VERSION')"
REQUIRES_WP="$(header_value "$ENTRY_FILE" 'Requires at least')"
REQUIRES_PHP="$(header_value "$ENTRY_FILE" 'Requires PHP')"
REQUIRES_PLUGINS="$(header_value "$ENTRY_FILE" 'Requires Plugins')"
TEXT_DOMAIN="$(header_value "$ENTRY_FILE" 'Text Domain')"
DOMAIN_PATH="$(header_value "$ENTRY_FILE" 'Domain Path')"
STABLE_TAG="$(header_value "$README_FILE" 'Stable tag')"
README_WP="$(header_value "$README_FILE" 'Requires at least')"
README_PHP="$(header_value "$README_FILE" 'Requires PHP')"

[[ "$VERSION" == '1.0.0-rc1' ]] || fail "release version must remain 1.0.0-rc1"
[[ "$CONSTANT_VERSION" == "$VERSION" ]] || fail "Version header and CB_DICTIONARY_VERSION differ"
[[ "$STABLE_TAG" == "$VERSION" ]] || fail "readme Stable tag and Version header differ"
[[ "$REQUIRES_WP" == '7.0' && "$README_WP" == '7.0' ]] || fail "Requires at least must be 7.0 in plugin and readme"
[[ "$REQUIRES_PHP" == '8.4' && "$README_PHP" == '8.4' ]] || fail "Requires PHP must be 8.4 in plugin and readme"
[[ "$REQUIRES_PLUGINS" == 'core-blueprint' ]] || fail "Requires Plugins must declare core-blueprint"
[[ "$TEXT_DOMAIN" == "$PLUGIN_SLUG" ]] || fail "Text Domain must be $PLUGIN_SLUG"
[[ "$DOMAIN_PATH" == '/languages' ]] || fail "Domain Path must be /languages"

echo "==> Release identity"
printf 'Version: %s\nWordPress: %s\nPHP: %s\nRequires Plugins: %s\n' "$VERSION" "$REQUIRES_WP" "$REQUIRES_PHP" "$REQUIRES_PLUGINS"

echo "==> Linting source PHP"
while IFS= read -r -d '' file; do
  php -l "$file" >/dev/null || fail "PHP lint failed: $file"
done < <(find "$ROOT_DIR" \
  -path "$ROOT_DIR/.git" -prune -o \
  -path "$BUILD_DIR" -prune -o \
  -type f -name '*.php' -print0)

echo "==> Running Dictionary conformance and regressions"
php "$ROOT_DIR/tools/conformance.php"
php "$ROOT_DIR/tests/archive-context-regression.php"
php "$ROOT_DIR/tests/bricks-adapter-regression.php"
php "$ROOT_DIR/tests/bricks-elements-regression.php"
php "$ROOT_DIR/tests/bricks-styling-regression.php"
php "$ROOT_DIR/tests/live-search-regression.php"

ZIP_PATH="$BUILD_DIR/$PLUGIN_SLUG-$VERSION.zip"
CHECKSUM_PATH="$ZIP_PATH.sha256"

rm -rf "$BUILD_DIR"
mkdir -p "$STAGE_DIR"

for path in "$MAIN_FILE" readme.txt uninstall.php; do
  [[ -f "$ROOT_DIR/$path" ]] || fail "missing required release file: $path"
  cp "$ROOT_DIR/$path" "$STAGE_DIR/"
done

for path in src assets languages; do
  if [[ -d "$ROOT_DIR/$path" ]]; then
    cp -R "$ROOT_DIR/$path" "$STAGE_DIR/"
  fi
done

find "$STAGE_DIR" -type f -name '.gitkeep' -delete

echo "==> Linting staged PHP"
while IFS= read -r -d '' file; do
  php -l "$file" >/dev/null || fail "staged PHP lint failed: $file"
done < <(find "$STAGE_DIR" -type f -name '*.php' -print0)

find "$STAGE_DIR" -exec touch -t 198001010000 {} +

(
  cd "$BUILD_DIR"
  zip -X -q "$ZIP_PATH" "$PLUGIN_SLUG/"
  find "$PLUGIN_SLUG" -type f -print | LC_ALL=C sort | zip -X -q "$ZIP_PATH" -@
)

[[ -s "$ZIP_PATH" ]] || fail "release ZIP was not created"
unzip -tqq "$ZIP_PATH" || fail "release ZIP integrity check failed"

ZIP_ENTRIES="$(unzip -Z1 "$ZIP_PATH")"
[[ -n "$ZIP_ENTRIES" ]] || fail "release ZIP is empty"
FIRST_ENTRY="${ZIP_ENTRIES%%$'\n'*}"
[[ "$FIRST_ENTRY" == "$PLUGIN_SLUG/" ]] || fail "release ZIP root is not $PLUGIN_SLUG/"

while IFS= read -r entry; do
  [[ "$entry" == "$PLUGIN_SLUG/"* ]] || fail "unexpected archive root entry: $entry"
done <<<"$ZIP_ENTRIES"

if grep -Eq '(^|/)(\.git|\.github|tests|tools|docs|build|dist|node_modules|vendor)(/|$)' <<<"$ZIP_ENTRIES"; then
  fail "development-only files leaked into the release ZIP"
fi

for required in \
  "$PLUGIN_SLUG/$MAIN_FILE" \
  "$PLUGIN_SLUG/readme.txt" \
  "$PLUGIN_SLUG/uninstall.php"; do
  grep -Fxq "$required" <<<"$ZIP_ENTRIES" || fail "required release entry missing: $required"
done

PACKAGED_ENTRY="$(unzip -p "$ZIP_PATH" "$PLUGIN_SLUG/$MAIN_FILE")"
PACKAGED_README="$(unzip -p "$ZIP_PATH" "$PLUGIN_SLUG/readme.txt")"
PACKAGED_VERSION="$(printf '%s' "$PACKAGED_ENTRY" | php -r '$s=stream_get_contents(STDIN); preg_match("/Version:\\s+([^\\r\\n]+)/",$s,$m); echo trim($m[1] ?? "");')"
PACKAGED_CONSTANT="$(printf '%s' "$PACKAGED_ENTRY" | php -r '$s=stream_get_contents(STDIN); preg_match("/define\\(\\s*[\\x27\\x22]CB_DICTIONARY_VERSION[\\x27\\x22]\\s*,\\s*[\\x27\\x22]([^\\x27\\x22]+)[\\x27\\x22]/",$s,$m); echo trim($m[1] ?? "");')"
PACKAGED_STABLE_TAG="$(printf '%s' "$PACKAGED_README" | php -r '$s=stream_get_contents(STDIN); preg_match("/^Stable tag:\\s*(.+)$/mi",$s,$m); echo trim($m[1] ?? "");')"

[[ "$PACKAGED_VERSION" == "$VERSION" ]] || fail "packaged Version header differs from verified source"
[[ "$PACKAGED_CONSTANT" == "$VERSION" ]] || fail "packaged CB_DICTIONARY_VERSION differs from verified source"
[[ "$PACKAGED_STABLE_TAG" == "$VERSION" ]] || fail "packaged Stable tag differs from verified source"

(
  cd "$BUILD_DIR"
  sha256sum "$(basename "$ZIP_PATH")" > "$(basename "$CHECKSUM_PATH")"
)
[[ -s "$CHECKSUM_PATH" ]] || fail "release checksum was not created"
SHA256="$(awk '{print $1}' "$CHECKSUM_PATH")"

printf 'Dictionary release package: PASS\nArtifact: %s\nChecksum: %s\nSHA-256: %s\n' "$ZIP_PATH" "$CHECKSUM_PATH" "$SHA256"
