#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLUGIN_SLUG="core-blueprint-dictionary"
ENTRY_FILE="$ROOT_DIR/core-blueprint-dictionary.php"
VERSION="$(php -r '$s=file_get_contents($argv[1]); preg_match("/Version:\\s+([^\\r\\n]+)/", $s, $m); echo trim($m[1] ?? "");' "$ENTRY_FILE")"

if [[ -z "$VERSION" ]]; then
  echo "Unable to determine plugin version." >&2
  exit 1
fi

for command in php zip find; do
  command -v "$command" >/dev/null 2>&1 || { echo "$command is required." >&2; exit 1; }
done

echo "==> Linting source PHP"
while IFS= read -r -d '' file; do
  php -l "$file" >/dev/null
done < <(find "$ROOT_DIR" -type f -name '*.php' -not -path '*/build/*' -not -path '*/.git/*' -print0)

echo "==> Running Dictionary conformance and regressions"
php "$ROOT_DIR/tools/conformance.php"
php "$ROOT_DIR/tests/archive-context-regression.php"
php "$ROOT_DIR/tests/bricks-adapter-regression.php"
php "$ROOT_DIR/tests/bricks-elements-regression.php"
php "$ROOT_DIR/tests/bricks-styling-regression.php"
php "$ROOT_DIR/tests/live-search-regression.php"

BUILD_DIR="$ROOT_DIR/build"
STAGE_DIR="$BUILD_DIR/$PLUGIN_SLUG"
ZIP_PATH="$BUILD_DIR/$PLUGIN_SLUG-$VERSION.zip"

rm -rf "$BUILD_DIR"
mkdir -p "$STAGE_DIR"

for path in core-blueprint-dictionary.php readme.txt uninstall.php; do
  [[ -f "$ROOT_DIR/$path" ]] || { echo "Missing required release file: $path" >&2; exit 1; }
  cp "$ROOT_DIR/$path" "$STAGE_DIR/"
done

for path in src assets languages; do
  if [[ -d "$ROOT_DIR/$path" ]]; then
    cp -R "$ROOT_DIR/$path" "$STAGE_DIR/"
  fi
done

find "$STAGE_DIR" -type f -name '.gitkeep' -delete

while IFS= read -r -d '' file; do
  php -l "$file" >/dev/null
done < <(find "$STAGE_DIR" -type f -name '*.php' -print0)

(
  cd "$BUILD_DIR"
  zip -X -qr "$(basename "$ZIP_PATH")" "$PLUGIN_SLUG"
)

ZIP_ENTRIES="$(unzip -Z1 "$ZIP_PATH")"
if grep -Eq '(^|/)(\.git|\.github|tests|tools|build|node_modules|vendor)(/|$)' <<<"$ZIP_ENTRIES"; then
  echo "Development-only files leaked into the release ZIP." >&2
  exit 1
fi

for required in   "$PLUGIN_SLUG/core-blueprint-dictionary.php"   "$PLUGIN_SLUG/readme.txt"   "$PLUGIN_SLUG/uninstall.php"; do
  grep -Fxq "$required" <<<"$ZIP_ENTRIES" || { echo "Missing release entry: $required" >&2; exit 1; }
done

echo "$ZIP_PATH"
