#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLUGIN_SLUG="core-blueprint-dictionary"
ENTRY_FILE="$ROOT_DIR/core-blueprint-dictionary.php"
VERSION="$(php -r '$s=file_get_contents($argv[1]); preg_match("/Version:\s+([^\r\n]+)/", $s, $m); echo trim($m[1] ?? "");' "$ENTRY_FILE")"

if [[ -z "$VERSION" ]]; then
  echo "Unable to determine plugin version." >&2
  exit 1
fi

for command in php python3 wp msgfmt rsync zip unzip; do
  command -v "$command" >/dev/null 2>&1 || { echo "${command} is required." >&2; exit 1; }
done

# Canonical suite-wide localization gate. Dictionary intentionally remains
# fail-closed while reviewed launch catalogs are not yet available.
"$ROOT_DIR/tools/i18n/check"

find "$ROOT_DIR" -type f -name '*.php' \
  -not -path '*/build/*' -not -path '*/dist/*' -print0 \
  | xargs -0 -n1 php -l >/dev/null
php "$ROOT_DIR/tools/conformance.php" >/dev/null

BUILD_DIR="$ROOT_DIR/build"
STAGE_DIR="$BUILD_DIR/$PLUGIN_SLUG"
ZIP_PATH="$BUILD_DIR/${PLUGIN_SLUG}-${VERSION}.zip"
rm -rf "$BUILD_DIR"
mkdir -p "$STAGE_DIR"

rsync -a \
  --exclude='.git/' \
  --exclude='.github/' \
  --exclude='build/' \
  --exclude='dist/' \
  --exclude='tests/' \
  --exclude='tools/' \
  --exclude='docs/' \
  --exclude='node_modules/' \
  --exclude='vendor/' \
  --exclude='.DS_Store' \
  --exclude='*.zip' \
  "$ROOT_DIR/" "$STAGE_DIR/"

(
  cd "$BUILD_DIR"
  zip -X -q -r "$(basename "$ZIP_PATH")" "$PLUGIN_SLUG"
)

ZIP_ENTRIES="$(unzip -Z1 "$ZIP_PATH")"
FIRST_ENTRY="${ZIP_ENTRIES%%$'\n'*}"
if [[ "$FIRST_ENTRY" != "$PLUGIN_SLUG/" ]]; then
  echo "Release ZIP root is not the canonical plugin folder." >&2
  exit 1
fi
if grep -Eq '(^|/)(\.git|\.github|tests|tools|docs|build|dist|node_modules|vendor)(/|$)' <<< "$ZIP_ENTRIES"; then
  echo "Development-only files leaked into the release ZIP." >&2
  exit 1
fi
if ! grep -Fxq "$PLUGIN_SLUG/core-blueprint-dictionary.php" <<< "$ZIP_ENTRIES"; then
  echo "Release ZIP is missing the plugin bootstrap." >&2
  exit 1
fi

unzip -tqq "$ZIP_PATH"
echo "$ZIP_PATH"
